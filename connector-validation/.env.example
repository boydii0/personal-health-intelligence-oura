# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file. It is already excluded via .gitignore.

# Oura API application credentials (from cloud.ouraring.com/oauth/applications)
OURA_CLIENT_ID=your_oura_client_id_here
OURA_CLIENT_SECRET=your_oura_client_secret_here

# Must exactly match the redirect URI registered on your Oura application
OURA_REDIRECT_URI=http://localhost:8000/callback

# OAuth scope requested for THIS validation test only. Do not widen without
# a separate approved step (heartrate / workout / spo2Daily are out of scope).
OURA_SCOPE=daily

# Absolute path to the root of your local AI_Vault (the folder that directly
# contains 00_System, 01_Daily, 02_Projects, 03_Areas, 04_People, 05_Resources,
# 06_Memory). Raw Oura data will be written under:
#   <VAULT_ROOT>/03_Areas/Health/Personal Health Repository/Source Data/Oura/
# If this is not set, the script will refuse to write and will report the
# constraint instead of inventing an alternate location.
VAULT_ROOT=/absolute/path/to/your/AI_Vault
